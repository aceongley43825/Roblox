[
 {
  "i": 0,
  "s": 0,
  "e": 1.64,
  "line": "In this town, there's one house"
 },
 {
  "i": 1,
  "s": 1.64,
  "e": 3.358,
  "line": "that nobody is allowed to enter."
 },
 {
  "i": 2,
  "s": 3.358,
  "e": 4.844,
  "line": "House Number 13."
 },
 {
  "i": 3,
  "s": 4.844,
  "e": 5.582,
  "line": "Mayor Grimley"
 },
 {
  "i": 4,
  "s": 5.582,
  "e": 7.178,
  "line": "tells everyone it's cursed."
 },
 {
  "i": 5,
  "s": 7.178,
  "e": 8.972,
  "line": "He says anyone who goes inside"
 },
 {
  "i": 6,
  "s": 8.972,
  "e": 10.492,
  "line": "will disappear forever."
 },
 {
  "i": 7,
  "s": 10.492,
  "e": 11.945,
  "line": "So every kid walks past it"
 },
 {
  "i": 8,
  "s": 11.945,
  "e": 12.925,
  "line": "a little faster,"
 },
 {
  "i": 9,
  "s": 12.925,
  "e": 14.873,
  "line": "and every grown-up crosses the street."
 },
 {
  "i": 10,
  "s": 14.873,
  "e": 15.611,
  "line": "But I always wondered"
 },
 {
  "i": 11,
  "s": 15.611,
  "e": 17.141,
  "line": "why a mayor would care so much"
 },
 {
  "i": 12,
  "s": 17.141,
  "e": 18.506,
  "line": "about one old house."
 },
 {
  "i": 13,
  "s": 18.506,
  "e": 19.376,
  "line": "So one night,"
 },
 {
  "i": 14,
  "s": 19.376,
  "e": 21.093,
  "line": "I climbed out of my bedroom window"
 },
 {
  "i": 15,
  "s": 21.093,
  "e": 23.394,
  "line": "and walked straight to House Number 13."
 },
 {
  "i": 16,
  "s": 23.394,
  "e": 23.967,
  "line": "The front door"
 },
 {
  "i": 17,
  "s": 23.967,
  "e": 25.068,
  "line": "wasn't even locked."
 },
 {
  "i": 18,
  "s": 25.068,
  "e": 27.523,
  "line": "Inside, everything was covered in dust."
 },
 {
  "i": 19,
  "s": 27.523,
  "e": 28.503,
  "line": "The stairs,"
 },
 {
  "i": 20,
  "s": 28.503,
  "e": 29.438,
  "line": "the sofa,"
 },
 {
  "i": 21,
  "s": 29.438,
  "e": 30.815,
  "line": "the paintings on the walls."
 },
 {
  "i": 22,
  "s": 30.815,
  "e": 32.301,
  "line": "Everything except one room"
 },
 {
  "i": 23,
  "s": 32.301,
  "e": 33.435,
  "line": "at the end of the hall."
 },
 {
  "i": 24,
  "s": 33.435,
  "e": 35.075,
  "line": "That room was spotless."
 },
 {
  "i": 25,
  "s": 35.075,
  "e": 36.671,
  "line": "The walls were covered with dozens"
 },
 {
  "i": 26,
  "s": 36.671,
  "e": 38.048,
  "line": "of newspaper articles,"
 },
 {
  "i": 27,
  "s": 38.048,
  "e": 39.534,
  "line": "all about Mayor Hollis,"
 },
 {
  "i": 28,
  "s": 39.534,
  "e": 41.901,
  "line": "the old mayor who mysteriously disappeared"
 },
 {
  "i": 29,
  "s": 41.901,
  "e": 43.134,
  "line": "twenty years ago,"
 },
 {
  "i": 30,
  "s": 43.134,
  "e": 45.446,
  "line": "on the same night Grimley became mayor."
 },
 {
  "i": 31,
  "s": 45.446,
  "e": 46.359,
  "line": "And on the desk,"
 },
 {
  "i": 32,
  "s": 46.359,
  "e": 47.802,
  "line": "there was a cup of tea."
 },
 {
  "i": 33,
  "s": 47.802,
  "e": 49.646,
  "line": "It was still warm. //"
 },
 {
  "i": 34,
  "s": 49.646,
  "e": 50.724,
  "line": "Then I heard footsteps"
 },
 {
  "i": 35,
  "s": 50.724,
  "e": 51.484,
  "line": "behind me."
 },
 {
  "i": 36,
  "s": 51.484,
  "e": 52.255,
  "line": "An old man"
 },
 {
  "i": 37,
  "s": 52.255,
  "e": 53.499,
  "line": "was standing in the doorway,"
 },
 {
  "i": 38,
  "s": 53.499,
  "e": 54.732,
  "line": "holding a candle."
 },
 {
  "i": 39,
  "s": 54.732,
  "e": 57.231,
  "line": "He said, \"Please don't go outside."
 },
 {
  "i": 40,
  "s": 57.231,
  "e": 59.047,
  "line": "The town is cursed.\""
 },
 {
  "i": 41,
  "s": 59.047,
  "e": 60.6,
  "line": "It was Mayor Hollis."
 },
 {
  "i": 42,
  "s": 60.6,
  "e": 61.668,
  "line": "Grimley had told him"
 },
 {
  "i": 43,
  "s": 61.668,
  "e": 63.242,
  "line": "that anyone who stepped outside"
 },
 {
  "i": 44,
  "s": 63.242,
  "e": 64.893,
  "line": "would disappear forever."
 },
 {
  "i": 45,
  "s": 64.893,
  "e": 66.864,
  "line": "So for twenty years,"
 },
 {
  "i": 46,
  "s": 66.864,
  "e": 68.273,
  "line": "he stayed inside,"
 },
 {
  "i": 47,
  "s": 68.273,
  "e": 70.409,
  "line": "and the whole town stayed out."
 },
 {
  "i": 48,
  "s": 70.409,
  "e": 71.829,
  "line": "Hollis and the whole town"
 },
 {
  "i": 49,
  "s": 71.829,
  "e": 72.49,
  "line": "were scared"
 },
 {
  "i": 50,
  "s": 72.49,
  "e": 74.482,
  "line": "of the exact same lie."
 },
 {
  "i": 51,
  "s": 74.482,
  "e": 75.748,
  "line": "So I took his hand,"
 },
 {
  "i": 52,
  "s": 75.748,
  "e": 76.937,
  "line": "opened the front door,"
 },
 {
  "i": 53,
  "s": 76.937,
  "e": 78.941,
  "line": "and walked him into the street."
 },
 {
  "i": 54,
  "s": 78.941,
  "e": 79.943,
  "line": "Nothing happened."
 },
 {
  "i": 55,
  "s": 79.943,
  "e": 80.823,
  "line": "The next morning,"
 },
 {
  "i": 56,
  "s": 80.823,
  "e": 82.893,
  "line": "the whole town came to see him."
 },
 {
  "i": 57,
  "s": 82.893,
  "e": 84.368,
  "line": "Grimley took one look at us"
 },
 {
  "i": 58,
  "s": 84.368,
  "e": 85.546,
  "line": "and ran so fast"
 },
 {
  "i": 59,
  "s": 85.546,
  "e": 87.099,
  "line": "he left a shoe behind."
 },
 {
  "i": 60,
  "s": 87.099,
  "e": 88.695,
  "line": "Nobody has seen him since."
 },
 {
  "i": 61,
  "s": 88.695,
  "e": 91.534,
  "line": "Some people say he disappeared forever. ///"
 }
]