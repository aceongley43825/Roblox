 },
 {
  "i": 9,
  "s": 12.34,
  "e": 14.41,
  "line": "in the middle of the town square."
 },
 {
  "i": 10,
  "s": 14.41,
  "e": 15.33,
  "line": "It's been standing there"
 },
 {
  "i": 11,
