 },
 {
  "i": 46,
  "s": 64.37,
  "e": 67.79,
  "line": "Everyone outside went completely silent. //"
 },
 {
  "i": 47,
  "s": 67.79,
  "e": 69.07,
  "line": "Then he said,"
 },
 {
  "i": 48,
  "s": 69.07,
  "e": 69.84,
  "line": "\"In a few years,"
 },
 {
  "i": 49,
