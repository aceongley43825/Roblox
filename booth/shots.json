  "e": 36.88,
  "line": "who sold ice cream."
 },
 {
  "i": 25,
  "s": 36.88,
  "e": 38.43,
  "line": "That's my grandpa."
 },
 {
  "i": 26,
  "s": 38.43,
  "e": 39.78,
  "line": "And everybody always says the same thing"
 },
 {
  "i": 27,
  "s": 39.78,
