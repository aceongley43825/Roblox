  "s": 23.44,
  "e": 25.9,
  "line": "the whole town comes to watch."
 },
 {
  "i": 17,
  "s": 25.9,
  "e": 26.91,
  "line": "My best friend Milo"
 },
 {
  "i": 18,
  "s": 26.91,
  "e": 28.43,
  "line": "went last spring."
 },
 {
  "i": 19,
  "s": 28.43,
  "e": 29.76,
