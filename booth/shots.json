[
 {
  "i": 0,
  "s": 0,
  "e": 1.03,
  "line": "In this town,"
 },
 {
  "i": 1,
  "s": 1.03,
  "e": 2.23,
  "line": "your sixteenth birthday"
 },
 {
  "i": 2,
  "s": 2.23,
  "e": 3.41,
