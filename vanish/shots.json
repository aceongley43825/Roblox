[
 {
  "i": 0,
  "s": 0,
  "e": 2.766,
  "line": "In this town, every night at exactly midnight,"
 },
 {
  "i": 1,
  "s": 2.766,
  "e": 3.989,
  "line": "one house disappears."
 },
 {
  "i": 2,
  "s": 3.989,
  "e": 5.014,
  "line": "Nobody knows why,"
 },
 {
  "i": 3,
  "s": 5.014,
  "e": 6.098,
  "line": "or where they go."
 },
 {
  "i": 4,
  "s": 6.098,
  "e": 8.396,
  "line": "But there's one rule everybody follows."
 },
 {
  "i": 5,
  "s": 8.396,
  "e": 9.888,
  "line": "If your house is chosen,"
 },
 {
  "i": 6,
  "s": 9.888,
  "e": 11.012,
  "line": "never look outside."
 },
 {
  "i": 7,
  "s": 11.012,
  "e": 12.046,
  "line": "My name is Jake."
 },
 {
  "i": 8,
  "s": 12.046,
  "e": 13.896,
  "line": "I've lived here my whole life."
 },
 {
  "i": 9,
  "s": 13.896,
  "e": 15.229,
  "line": "Next door lives Linda,"
 },
 {
  "i": 10,
  "s": 15.229,
  "e": 16.562,
  "line": "and her pink flamingo."
 },
 {
  "i": 11,
  "s": 16.562,
  "e": 18.92,
  "line": "Across the street, my best friend Kevin."
 },
 {
  "i": 12,
  "s": 18.92,
  "e": 20.253,
  "line": "One night, at midnight,"
 },
 {
  "i": 13,
  "s": 20.253,
  "e": 21.645,
  "line": "Then I heard a scream. //"
 },
 {
  "i": 14,
  "s": 21.645,
  "e": 22.769,
  "line": "From Linda's house."
 },
 {
  "i": 15,
  "s": 22.769,
  "e": 23.804,
  "line": "I knew the rule."
 },
 {
  "i": 16,
  "s": 23.804,
  "e": 25.037,
  "line": "But I looked anyway."
 },
 {
  "i": 17,
  "s": 25.037,
  "e": 26.261,
  "line": "Her lights flickered."
 },
 {
  "i": 18,
  "s": 26.261,
  "e": 27.494,
  "line": "The roof lifted off."
 },
 {
  "i": 19,
  "s": 27.494,
  "e": 29.752,
  "line": "The whole house floated into the sky."
 },
 {
  "i": 20,
  "s": 29.752,
  "e": 30.627,
  "line": "Gone. No trace."
 },
 {
  "i": 21,
  "s": 30.627,
  "e": 32.318,
  "line": "The next morning, only grass."
 },
 {
  "i": 22,
  "s": 32.318,
  "e": 33.751,
  "line": "But something was wrong."
 },
 {
  "i": 23,
  "s": 33.751,
  "e": 35.183,
  "line": "Kevin walked right past."
 },
 {
  "i": 24,
  "s": 35.183,
  "e": 36.974,
  "line": "I asked, where's Linda's house?"
 },
 {
  "i": 25,
  "s": 36.974,
  "e": 38.207,
  "line": "He said, who's Linda?"
 },
 {
  "i": 26,
  "s": 38.207,
  "e": 40.366,
  "line": "Mom said that lot was always empty."
 },
 {
  "i": 27,
  "s": 40.366,
  "e": 41.639,
  "line": "Nobody remembered her."
 },
 {
  "i": 28,
  "s": 41.639,
  "e": 42.514,
  "line": "Nobody but me."
 },
 {
  "i": 29,
  "s": 42.514,
  "e": 43.24,
  "line": "Then I saw"
 },
 {
  "i": 30,
  "s": 43.24,
  "e": 44.314,
  "line": "her pink flamingo,"
 },
 {
  "i": 31,
  "s": 44.314,
  "e": 45.548,
  "line": "standing in my yard,"
 },
 {
  "i": 32,
  "s": 45.548,
  "e": 46.831,
  "line": "staring at my window."
 },
 {
  "i": 33,
  "s": 46.831,
  "e": 48.313,
  "line": "The houses aren't chosen."
 },
 {
  "i": 34,
  "s": 48.313,
  "e": 50.253,
  "line": "They're taken when someone looks."
 },
 {
  "i": 35,
  "s": 50.253,
  "e": 51.486,
  "line": "The scream was bait."
 },
 {
  "i": 36,
  "s": 51.486,
  "e": 52.411,
  "line": "The next night,"
 },
 {
  "i": 37,
  "s": 52.411,
  "e": 53.794,
  "line": "I heard another scream."
 },
 {
  "i": 38,
  "s": 53.794,
  "e": 55.236,
  "line": "From my own front yard. ///"
 },
 {
  "i": 39,
  "s": 55.236,
  "e": 56.321,
  "line": "So I didn't look."
 },
 {
  "i": 40,
  "s": 56.321,
  "e": 57.654,
  "line": "But across the street,"
 },
 {
  "i": 41,
  "s": 57.654,
  "e": 58.27,
  "line": "Kevin did."
 },
 {
  "i": 42,
  "s": 58.27,
  "e": 59.844,
  "line": "Never look outside."
 }
]